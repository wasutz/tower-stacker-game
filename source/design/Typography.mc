import Toybox.Lang;
import Toybox.WatchUi;

//! Space Grotesk at the design's sizes, generated per screen by tools/generate_fonts.py.
class Typography {
    public var title as FontResource = WatchUi.loadResource(Rez.Fonts.Title) as FontResource;
    public var record as FontResource = WatchUi.loadResource(Rez.Fonts.Record) as FontResource;
    public var prompt as FontResource = WatchUi.loadResource(Rez.Fonts.Prompt) as FontResource;
    public var score as FontResource = WatchUi.loadResource(Rez.Fonts.Score) as FontResource;
    public var caption as FontResource = WatchUi.loadResource(Rez.Fonts.Caption) as FontResource;
    public var best as FontResource = WatchUi.loadResource(Rez.Fonts.Best) as FontResource;
    public var verdict as FontResource = WatchUi.loadResource(Rez.Fonts.Verdict) as FontResource;
    public var hero as FontResource = WatchUi.loadResource(Rez.Fonts.Hero) as FontResource;
    public var unit as FontResource = WatchUi.loadResource(Rez.Fonts.Unit) as FontResource;
    public var hint as FontResource = WatchUi.loadResource(Rez.Fonts.Hint) as FontResource;
}
